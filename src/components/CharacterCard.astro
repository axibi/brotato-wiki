---
import PixelSprite from './PixelSprite.astro';
import type { Character } from '@/lib/data';
import { DIFFICULTY_LABEL } from '@/lib/site';

interface Props {
  c: Character;
  index?: number;
}
const { c, index = 0 } = Astro.props;
---

<a
  href={`/characters/${c.slug}`}
  class="card group flex flex-col p-4"
  data-filter-item
  data-search={`${c.nameZh} ${c.name} ${c.tagline} ${c.tags.join(' ')} ${c.playstyle}`}
  data-facet={`阵营:${c.isDlc ? 'dlc' : 'base'} ${c.tags.map((t) => `tag:${t}`).join(' ')} diff:${c.difficulty}`}
  style={`animation-delay:${Math.min(index, 24) * 22}ms`}
>
  <div class="flex items-start gap-3">
    <div class="relative grid h-[68px] w-[68px] shrink-0 place-items-center overflow-hidden rounded-xl border border-line bg-gradient-to-br from-white/[0.06] to-transparent">
      <PixelSprite seed={c.slug} kind="character" size={56} alt={`${c.nameZh}像素形象`} />
      <span class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,rgba(0,0,0,0.16)_0px,rgba(0,0,0,0.16)_1px,transparent_1px,transparent_3px)] opacity-40"></span>
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5">
        <h3 class="truncate text-[15px] font-bold text-cream transition group-hover:text-orange-2">{c.nameZh}</h3>
        {c.isDlc && <span class="tag tag-dlc h-[18px] px-1.5 text-[10px]">DLC</span>}
      </div>
      <p class="mt-0.5 truncate font-mono text-[11px] uppercase tracking-wider text-dim">{c.name}</p>
      <div class="mt-2 flex items-center gap-1" aria-label={`难度 ${DIFFICULTY_LABEL[c.difficulty]}`}>
        {[1, 2, 3, 4, 5].map((i) => (
          <span
            class:list={['h-1 w-3 rounded-full', i <= c.difficulty ? 'bg-orange' : 'bg-white/12']}
          ></span>
        ))}
        <span class="ml-1 text-[10.5px] text-dim">{DIFFICULTY_LABEL[c.difficulty]}</span>
      </div>
    </div>
  </div>

  <p class="mt-3 line-clamp-2 min-h-[38px] text-[12.5px] leading-relaxed text-muted">{c.tagline}</p>

  <div class="mt-3 flex flex-wrap gap-1.5">
    {c.tags.slice(0, 3).map((t) => <span class="tag h-[21px] px-1.5 text-[10.5px]">{t}</span>)}
  </div>
</a>
