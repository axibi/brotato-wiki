---
import { NAV, SITE } from '@/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-ink/85 backdrop-blur-xl">
  <div class="wrap flex h-16 items-center gap-4 md:h-[68px]">
    <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${SITE.name} 首页`}>
      <span class="relative grid h-9 w-9 place-items-center rounded-[9px] border border-orange/40 bg-gradient-to-b from-orange/25 to-orange/5 transition group-hover:border-orange/80">
        <svg width="22" height="22" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
          <rect x="4" y="2" width="8" height="1" fill="#ffb066"/>
          <rect x="3" y="3" width="10" height="1" fill="#ff9a4d"/>
          <rect x="2" y="4" width="12" height="8" fill="#ff8a3c"/>
          <rect x="3" y="12" width="10" height="1" fill="#c9561a"/>
          <rect x="4" y="13" width="8" height="1" fill="#7a2f0d"/>
          <rect x="5" y="6" width="2" height="2" fill="#1a0d04"/>
          <rect x="9" y="6" width="2" height="2" fill="#1a0d04"/>
          <rect x="6" y="10" width="4" height="1" fill="#7a2f0d"/>
        </svg>
      </span>
      <span class="leading-none">
        <span class="block text-[15px] font-extrabold tracking-tight text-cream">土豆兄弟百科</span>
        <span class="mt-1 block text-[10px] font-medium uppercase tracking-[0.2em] text-dim">Brotato Wiki</span>
      </span>
    </a>

    <nav class="ml-2 hidden items-center gap-1 lg:flex" aria-label="主导航">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class:list={[
              'rounded-lg px-3 py-2 text-[13.5px] font-medium transition-colors',
              isActive(n.href) ? 'bg-orange/12 text-orange-2' : 'text-muted hover:bg-white/5 hover:text-cream',
            ]}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <span class="hidden rounded-md border border-line bg-white/[0.03] px-2 py-1 font-mono text-[11px] text-dim md:block">
        v{SITE.version}
      </span>
      <button
        type="button"
        data-search-open
        class="flex h-9 items-center gap-2 rounded-lg border border-line bg-white/[0.03] px-3 text-[13px] text-muted transition hover:border-orange/50 hover:text-cream"
        aria-label="打开全站搜索"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="hidden sm:inline">搜索</span>
        <kbd class="hidden rounded border border-line bg-black/40 px-1.5 py-0.5 font-mono text-[10px] text-dim sm:inline">/</kbd>
      </button>
      <button
        type="button"
        data-menu-toggle
        class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-white/[0.03] text-cream lg:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div data-mobile-menu class="hidden border-t border-line bg-ink-2/95 lg:hidden">
    <nav class="wrap grid gap-1 py-3" aria-label="移动端导航">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium',
              isActive(n.href) ? 'bg-orange/12 text-orange-2' : 'text-muted',
            ]}
          >
            {n.label}
          </a>
        ))
      }
      <a href="/about" class="rounded-lg px-3 py-2.5 text-sm font-medium text-muted">关于与资料来源</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = !menu?.classList.contains('hidden');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
