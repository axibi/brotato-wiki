---
/**
 * 程序化像素贴图：根据名称哈希生成固定造型，全部为本站原创图形，不使用游戏素材。
 */
interface Props {
  seed: string;
  kind?: 'character' | 'weapon' | 'item';
  rarity?: number;
  size?: number;
  class?: string;
  alt?: string;
}

const { seed, kind = 'item', rarity = 1, size = 72, class: cls = '', alt = '' } = Astro.props;

function hash(str: string) {
  let h = 2166136261;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

const H = hash(seed);
const variant = kind === 'weapon' ? H % 8 : H % 5;

const PALETTES: Record<string, string[][]> = {
  character: [
    ['#ffc994', '#ff9a4d', '#c85f22', '#5c2509'],
    ['#a9edb9', '#5fc97e', '#2b7d49', '#0f3a20'],
    ['#a6d9ff', '#5aa7e8', '#28619b', '#0d2f4a'],
    ['#f4b6e6', '#c96fb8', '#82306f', '#37122f'],
    ['#ffe19a', '#e8b13f', '#9c6f15', '#432c05'],
  ],
  weapon: [
    ['#eef4fb', '#b7c6d6', '#74869a', '#2f3a44'],
    ['#ffd9b5', '#f0a266', '#a85b25', '#4f2708'],
    ['#ded1ff', '#a58cf0', '#5d3fa8', '#291a4d'],
  ],
  item: [
    ['#ffe1b0', '#f0ad58', '#a96718', '#4f2f06'],
    ['#cdf7d8', '#6fd68f', '#2c8551', '#113d22'],
    ['#c9e9ff', '#69bdf5', '#2a6fab', '#0f3554'],
    ['#ffc9d1', '#f0697f', '#a52a3c', '#520f1b'],
  ],
};

const kindIdx = kind === 'character' ? H % 5 : kind === 'weapon' ? H % 3 : (rarity - 1) % 4;
const [light, base, shade, outline] = PALETTES[kind][kindIdx];

const N = 12;
type Rect = [number, number, number, number, string];
const rects: Rect[] = [];
const put = (x: number, y: number, w: number, h: number, c: string) => rects.push([x, y, w, h, c]);

/* ---------- 角色：土豆轮廓 + 明暗 + 五官 ---------- */
if (kind === 'character') {
  const cx = 5.5;
  const cy = 6.3;
  const rx = 4.5 + ((H >> 3) % 3) * 0.1;
  const ry = 4.1 + ((H >> 5) % 3) * 0.1;
  const inside: boolean[][] = [];
  for (let y = 0; y < N; y++) {
    inside[y] = [];
    for (let x = 0; x < N; x++) {
      const dx = (x + 0.5 - cx) / rx;
      const dy = (y + 0.5 - cy) / ry;
      inside[y][x] = dx * dx + dy * dy <= 1;
    }
  }
  for (let y = 0; y < N; y++) {
    for (let x = 0; x < N; x++) {
      if (!inside[y][x]) continue;
      const edge =
        !inside[y - 1]?.[x] || !inside[y + 1]?.[x] || !inside[y]?.[x - 1] || !inside[y]?.[x + 1];
      if (edge) {
        put(x, y, 1, 1, outline);
      } else if (y >= 8) {
        put(x, y, 1, 1, shade);
      } else {
        put(x, y, 1, 1, base);
      }
    }
  }
  // 高光
  put(4, 3, 2, 1, light);
  put(3, 4, 1, 1, light);
  // 眼睛（1 宽 2 高）+ 嘴
  put(3, 5, 1, 2, '#1a0d04');
  put(8, 5, 1, 2, '#1a0d04');
  put(5, 8, 2, 1, '#1a0d04');
}

/* ---------- 武器：五种造型 ---------- */
if (kind === 'weapon') {
  if (variant === 0) {
    // 剑
    put(5, 1, 2, 6, light);
    put(6, 1, 1, 6, base);
    put(3, 7, 6, 1, shade);
    put(5, 8, 2, 2, outline);
    put(5, 10, 2, 1, base);
  } else if (variant === 1) {
    // 枪
    put(2, 4, 7, 2, base);
    put(2, 4, 7, 1, light);
    put(8, 3, 2, 1, shade);
    put(4, 6, 3, 4, outline);
    put(5, 6, 1, 3, shade);
    put(9, 4, 1, 2, light);
  } else if (variant === 2) {
    // 法杖
    for (let i = 0; i < 8; i++) put(3 + i, 10 - i, 1, 1, i % 2 ? base : shade);
    put(9, 1, 3, 3, light);
    put(10, 1, 2, 2, base);
    put(9, 2, 1, 1, shade);
  } else if (variant === 3) {
    // 斧
    put(6, 2, 2, 9, outline);
    put(6, 2, 1, 9, shade);
    put(2, 2, 4, 4, base);
    put(2, 2, 2, 2, light);
    put(2, 5, 4, 1, shade);
  } else if (variant === 4) {
    // 锤
    put(6, 4, 2, 7, shade);
    put(3, 2, 6, 3, base);
    put(3, 2, 6, 1, light);
    put(3, 4, 6, 1, outline);
  } else if (variant === 5) {
    // 长矛
    for (let i = 0; i < 9; i++) put(2 + i, 10 - i, 1, 1, shade);
    for (let i = 0; i < 3; i++) put(9 + i, 1 + i, 1, 1, light);
    put(10, 1, 2, 2, base);
    put(2, 10, 2, 1, outline);
  } else if (variant === 6) {
    // 弩
    put(2, 3, 1, 6, shade);
    put(3, 2, 1, 8, base);
    put(4, 2, 1, 8, light);
    put(5, 5, 4, 2, base);
    put(5, 5, 4, 1, light);
    put(7, 7, 1, 3, outline);
  } else {
    // 炸弹
    put(3, 3, 6, 6, base);
    put(4, 2, 4, 1, light);
    put(4, 4, 2, 2, light);
    put(3, 8, 6, 1, outline);
    put(8, 1, 1, 2, shade);
    put(9, 0, 1, 1, light);
  }
}

/* ---------- 道具：瓶 / 箱 / 球 / 果 四种造型 ---------- */
if (kind === 'item') {
  if (variant === 0) {
    // 药瓶
    put(5, 1, 2, 2, shade);
    put(4, 3, 4, 1, outline);
    put(3, 4, 6, 6, base);
    put(3, 4, 6, 1, light);
    put(3, 8, 6, 2, shade);
    put(4, 10, 4, 1, outline);
    put(4, 5, 1, 3, light);
  } else if (variant === 1) {
    // 箱子
    put(2, 3, 8, 7, base);
    put(2, 3, 8, 1, light);
    put(2, 9, 8, 1, outline);
    put(5, 3, 2, 7, shade);
    put(2, 6, 8, 1, outline);
  } else if (variant === 2) {
    // 宝珠
    put(4, 2, 4, 1, light);
    put(3, 3, 6, 6, base);
    put(4, 2, 2, 1, light);
    put(3, 8, 6, 1, shade);
    put(4, 9, 4, 1, outline);
    put(4, 4, 1, 1, '#ffffff');
    put(5, 4, 1, 1, light);
  } else {
    // 果实
    put(5, 1, 3, 1, shade);
    put(8, 0, 2, 2, '#4f8a3a');
    put(3, 3, 6, 6, base);
    put(4, 2, 4, 1, light);
    put(3, 8, 6, 1, shade);
    put(4, 9, 4, 1, outline);
    put(4, 4, 1, 1, light);
  }
}

const svg = rects
  .map(([x, y, w, h, c]) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${c}"/>`)
  .join('');
---

<svg
  width={size}
  height={size}
  viewBox={`0 0 ${N} ${N}`}
  class={cls}
  role={alt ? 'img' : 'presentation'}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : 'true'}
  shape-rendering="crispEdges"
  style={`image-rendering: pixelated; width:${size}px;height:${size}px`}
>
  <Fragment set:html={svg} />
</svg>
