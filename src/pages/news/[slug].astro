---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((n) => ({ params: { slug: n.id }, props: { entry: n } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const all = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const i = all.findIndex((x) => x.id === entry.id);
const next = all[i + 1];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString().slice(0, 10),
  inLanguage: 'zh-CN',
  author: { '@type': 'Organization', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: `${SITE.url}/news/${entry.id}`,
};
---

<BaseLayout title={d.title} description={d.description} type="article" jsonLd={jsonLd}>
  <article class="wrap pt-10 md:pt-14">
    <Breadcrumbs items={[{ href: '/news', label: '版本动态' }, { label: d.version }]} jsonLd={false} />

    <header class="mt-6 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="tag tag-orange">版本 {d.version}</span>
        <span class="tag">{d.status}</span>
        <span class="text-[11.5px] text-dim">{d.date.toISOString().slice(0, 10)}</span>
      </div>
      <h1 class="mt-4 text-[30px] font-extrabold leading-tight tracking-tight text-cream md:text-[36px]">{d.title}</h1>
      <p class="mt-3 text-[14.5px] leading-relaxed text-muted">{d.description}</p>
    </header>

    <div class="prose-b mt-8 max-w-3xl">
      <Content />
    </div>

    <nav class="mt-12 max-w-3xl border-t border-line pt-6">
      {next && <a href={`/news/${next.id}`} class="card block p-4"><p class="text-[11px] text-dim">更早的记录</p><p class="mt-1 text-[13.5px] text-cream">{next.data.title}</p></a>}
      <a href="/news" class="mt-4 inline-block text-[12.5px] text-orange-2 hover:underline">← 返回版本动态</a>
    </nav>
  </article>
</BaseLayout>
