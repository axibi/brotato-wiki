---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/lib/site';
import patches from '@/data/patches.json';

const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const statusCls: Record<string, string> = {
  已确认: 'tag',
  部分待核实: 'tag tag-orange',
  待核实: 'tag',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '土豆兄弟版本动态',
  description: 'Brotato 版本更新与资料基线记录。',
  url: `${SITE.url}/news`,
};
---

<BaseLayout title="版本动态" description="土豆兄弟 Brotato 的版本更新记录、DLC 信息与本站资料基线说明，区分已确认与待核实内容。" jsonLd={jsonLd}>
  <section class="wrap pt-10 md:pt-14">
    <Breadcrumbs items={[{ label: '版本动态' }]} />
    <div class="mt-6">
      <p class="eyebrow">Patch Notes</p>
      <h1 class="h-section">版本动态</h1>
      <p class="lead mt-3 max-w-2xl">
        记录游戏版本演进与本站资料基线。我们不会把旧版本数据冒充为当前数据——每一条都标注了核实状态。
      </p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <div class="card-flat p-5">
        <p class="text-[11px] uppercase tracking-widest text-dim">当前资料基线</p>
        <p class="mt-2 font-mono text-2xl font-bold text-orange-2">{SITE.version}</p>
        <p class="mt-1 text-[11.5px] text-dim">Wiki 数据页标注 Patch {patches.wikiPatch}</p>
      </div>
      <div class="card-flat p-5 md:col-span-2">
        <p class="text-[11px] uppercase tracking-widest text-dim">说明</p>
        <p class="mt-2 text-[12.5px] leading-relaxed text-muted">{patches.note}</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="text-[15px] font-bold text-cream">版本时间线</h2>
    <ol class="mt-6 space-y-4 border-l border-line pl-6">
      {
        patches.timeline.map((t) => (
          <li class="relative">
            <span class="absolute -left-[30px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-ink bg-orange"></span>
            <div class="card-flat p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-[13px] font-bold text-orange-2">{t.version}</span>
                <span class="text-[11px] text-dim">{t.date}</span>
                <span class="tag h-[20px] px-1.5 text-[10px]">{t.status}</span>
              </div>
              <h3 class="mt-2 text-[14px] font-semibold text-cream">{t.title}</h3>
              <p class="mt-1 text-[12.5px] leading-relaxed text-muted">{t.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <h2 class="mt-14 text-[15px] font-bold text-cream">更新记录</h2>
    <div class="mt-4 grid gap-3">
      {
        news.map((n) => (
          <a href={`/news/${n.id}`} class="card group flex flex-col gap-2 p-5 md:flex-row md:items-center">
            <div class="flex items-center gap-2 md:w-44 md:shrink-0">
              <span class="font-mono text-[12px] text-orange-2">{n.data.version}</span>
              <span class="text-[11px] text-dim">{n.data.date.toISOString().slice(0, 10)}</span>
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-[14.5px] font-semibold text-cream transition group-hover:text-orange-2">{n.data.title}</h3>
              <p class="mt-1 line-clamp-1 text-[12.5px] text-muted">{n.data.description}</p>
            </div>
            <span class:list={['shrink-0', statusCls[n.data.status]]}>{n.data.status}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
