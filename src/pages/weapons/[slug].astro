---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PixelSprite from '@/components/PixelSprite.astro';
import { weapons, characters, bySlug } from '@/lib/data';
import { SITE, TIER_ZH } from '@/lib/site';

export async function getStaticPaths() {
  return weapons.map((w) => ({ params: { slug: w.slug }, props: { w } }));
}

const { w } = Astro.props;
const idx = weapons.findIndex((x) => x.slug === w.slug);
const prev = weapons[idx - 1];
const next = weapons[idx + 1];

const users = characters.filter((c) => c.recommendedWeapons.includes(w.nameZh)).slice(0, 6);
const sameClass = weapons
  .filter((x) => x.slug !== w.slug && x.classes.some((c) => w.classes.includes(c)))
  .slice(0, 6);

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.data.tags.includes('武器') || g.data.tags.includes('构筑'))
  .slice(0, 3);

const t1 = w.tiers[w.tiers.length - 1];
const scaling = (w.tiers[0].damage.match(/\(([^)]+)\)/)?.[1] ?? '').replace(/(\d+%)/g, '$1 ');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${w.nameZh}（${w.name}）— 土豆兄弟武器`,
    description: `${w.nameZh}：${w.classes.join('/')}武器，${w.note}`,
    url: `${SITE.url}/weapons/${w.slug}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '武器图鉴', item: `${SITE.url}/weapons` },
      { '@type': 'ListItem', position: 3, name: w.nameZh, item: `${SITE.url}/weapons/${w.slug}` },
    ],
  },
];
---

<BaseLayout
  title={`${w.nameZh} ${w.name} — 属性、阶级与适用流派`}
  description={`${w.nameZh}（${w.name}）：${w.classes.join('、')}类武器。查看 I~IV 阶伤害、冷却、DPS、射程、价格与推荐角色。`}
  jsonLd={jsonLd}
>
  <article class="wrap pt-10 md:pt-14">
    <Breadcrumbs items={[{ href: '/weapons', label: '武器图鉴' }, { label: w.nameZh }]} jsonLd={false} />

    <header class="mt-6 grid gap-6 md:grid-cols-[auto_1fr] md:items-start md:gap-8">
      <div class="relative grid h-[132px] w-[132px] place-items-center overflow-hidden rounded-2xl border border-line-strong bg-gradient-to-br from-white/[0.08] via-transparent to-transparent">
        <PixelSprite seed={w.slug} kind="weapon" size={104} alt={`${w.nameZh}像素图`} class="float-y" />
        <span class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,rgba(0,0,0,0.18)_0px,rgba(0,0,0,0.18)_1px,transparent_1px,transparent_4px)] opacity-40"></span>
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          {w.classes.map((c) => <span class="tag tag-orange">{c}</span>)}
          {w.isDlc && <span class="tag tag-dlc">DLC 武器</span>}
          <span class="tag">可获得阶级 {TIER_ZH[w.minTier]} – {TIER_ZH[w.maxTier]}</span>
          {w.attackType && <span class="tag">攻击方式 {w.attackType === 'Sweep' ? '横扫' : w.attackType === 'Thrust' ? '突刺' : w.attackType}</span>}
        </div>
        <h1 class="mt-3 text-[34px] font-extrabold leading-tight tracking-tight text-cream md:text-[42px]">
          {w.nameZh} <span class="ml-1 font-mono text-[16px] font-normal uppercase tracking-widest text-dim md:text-[18px]">{w.name}</span>
        </h1>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{w.note}</p>
      </div>
    </header>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <section class="card-flat overflow-hidden">
          <div class="flex items-center justify-between border-b border-line px-5 py-4">
            <h2 class="text-[15px] font-bold text-cream">各阶级属性</h2>
            <span class="font-mono text-[11px] text-dim">DPS 不计暴击与特效</span>
          </div>
          <div class="overflow-x-auto">
            <table class="data-table min-w-[560px]">
              <thead>
                <tr>
                  <th>阶级</th>
                  <th>伤害</th>
                  <th>冷却</th>
                  <th>DPS</th>
                  <th>暴击</th>
                  <th>射程</th>
                  <th>击退</th>
                  <th>价格</th>
                </tr>
              </thead>
              <tbody>
                {
                  w.tiers.map((t) => (
                    <tr>
                      <td class="whitespace-nowrap"><span class:list={['tag', `r-${t.tier}`]}>{TIER_ZH[t.tier]}</span></td>
                      <td class="font-mono text-[12.5px] text-cream">{t.damage}</td>
                      <td class="font-mono text-[12.5px]">{t.cooldown}</td>
                      <td class="font-mono text-[12.5px] text-orange-2">{t.dps}</td>
                      <td class="font-mono text-[12.5px]">{t.crit}</td>
                      <td class="font-mono text-[12.5px]">{t.range ?? '—'}</td>
                      <td class="font-mono text-[12.5px]">{t.knockback ?? '—'}</td>
                      <td class="font-mono text-[12.5px]">{t.price ?? '—'}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="border-t border-line px-5 py-3 text-[11.5px] text-dim">
            伤害 = 基础值（属性缩放）。括号内为每点对应属性提供的额外伤害比例。
          </div>
        </section>

        {
          w.special && (
            <section class="card-flat mt-4 p-5 md:p-6">
              <h2 class="flex items-center gap-2 text-[15px] font-bold text-cream">
                <span class="h-4 w-1 rounded bg-orange"></span>特殊效果
              </h2>
              <p class="mt-3 text-[13.5px] leading-relaxed text-[#d5cabd]">{w.special}</p>
              <p class="mt-2 text-[11px] text-dim">部分效果随阶级提升，具体数值以游戏内为准。</p>
            </section>
          )
        }

        <section class="card-flat mt-4 p-5 md:p-6">
          <h2 class="text-[15px] font-bold text-cream">怎么用这把武器</h2>
          <ul class="mt-3 grid gap-2.5 text-[13.5px] leading-relaxed text-[#d5cabd]">
            <li class="flex gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-orange"></span><span>缩放属性：<span class="text-cream">{scaling || '见上表'}</span>，优先堆这些属性才能放大面板。</span></li>
            <li class="flex gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-orange"></span><span>一阶价格 {w.tiers[0].price ?? '—'} 材料，满阶价格 {t1.price ?? '—'} 材料，前期是否值得买要看能否合成。</span></li>
            <li class="flex gap-2.5"><span class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-orange"></span><span>职业：{w.classes.join(' / ')}。同职业武器叠到 2 把以上会触发职业加成。</span></li>
          </ul>
        </section>

        {
          users.length > 0 && (
            <section class="mt-6">
              <h2 class="text-[15px] font-bold text-cream">推荐使用该武器的角色</h2>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                {users.map((c) => (
                  <a href={`/characters/${c.slug}`} class="card flex items-center gap-3 p-3">
                    <PixelSprite seed={c.slug} kind="character" size={30} />
                    <span class="text-[13px] text-cream">{c.nameZh}</span>
                    <span class="ml-auto text-[11px] text-dim">{c.tags[0]}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="space-y-4">
        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">速览</h2>
          <dl class="mt-3 space-y-2.5 text-[12.5px]">
            <div class="flex justify-between gap-3"><dt class="text-dim">职业</dt><dd class="text-right text-cream">{w.classes.join(' / ')}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">最低阶级</dt><dd class="text-cream">{TIER_ZH[w.minTier]}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">基础伤害</dt><dd class="font-mono text-cream">{w.tiers[0].damage.replace(/\(.*\)/, '')}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">基础冷却</dt><dd class="font-mono text-cream">{w.tiers[0].cooldown}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">数据版本</dt><dd class="font-mono text-cream">{SITE.version}</dd></div>
          </dl>
        </div>

        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">同职业武器</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {sameClass.map((s) => <a href={`/weapons/${s.slug}`} class="tag transition hover:border-orange/50 hover:text-orange-2">{s.nameZh}</a>)}
          </div>
        </div>

        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">相关攻略</h2>
          <ul class="mt-3 space-y-2">
            {guides.map((g) => <li><a href={`/guides/${g.id}`} class="text-[12.5px] text-muted transition hover:text-orange-2">{g.data.title}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>

    <nav class="mt-10 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="武器翻页">
      {prev ? <a href={`/weapons/${prev.slug}`} class="card p-4"><p class="text-[11px] text-dim">← 上一个</p><p class="mt-1 text-[14px] font-medium text-cream">{prev.nameZh}</p></a> : <span></span>}
      {next && <a href={`/weapons/${next.slug}`} class="card p-4 text-right"><p class="text-[11px] text-dim">下一个 →</p><p class="mt-1 text-[14px] font-medium text-cream">{next.nameZh}</p></a>}
    </nav>
  </article>
</BaseLayout>
