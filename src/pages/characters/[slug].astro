---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PixelSprite from '@/components/PixelSprite.astro';
import { characters, weapons, items, bySlug } from '@/lib/data';
import { SITE, DIFFICULTY_LABEL } from '@/lib/site';

export async function getStaticPaths() {
  return characters.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const idx = characters.findIndex((x) => x.slug === c.slug);
const prev = characters[idx - 1];
const next = characters[idx + 1];

const recWeapons = c.recommendedWeapons.map((n) => weapons.find((w) => w.nameZh === n)).filter(Boolean);
const recItems = c.recommendedItems.map((n) => items.find((i) => i.nameZh === n)).filter(Boolean);

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .filter((g) => g.data.tags.some((t) => c.tags.includes(t)) || g.data.category === '入门')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const related = characters
  .filter((x) => x.slug !== c.slug && x.tags.some((t) => c.tags.includes(t)))
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${c.nameZh}（${c.name}）— 土豆兄弟角色`,
    description: c.tagline,
    url: `${SITE.url}/characters/${c.slug}`,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '角色图鉴', item: `${SITE.url}/characters` },
      { '@type': 'ListItem', position: 3, name: c.nameZh, item: `${SITE.url}/characters/${c.slug}` },
    ],
  },
];
---

<BaseLayout
  title={`${c.nameZh} ${c.name} — 能力、解锁条件与玩法`}
  description={`${c.nameZh}（${c.name}）：${c.tagline}。初始能力、优势劣势、推荐武器与道具、上手难度 ${DIFFICULTY_LABEL[c.difficulty]}。`}
  jsonLd={jsonLd}
>
  <article class="wrap pt-10 md:pt-14">
    <Breadcrumbs items={[{ href: '/characters', label: '角色图鉴' }, { label: c.nameZh }]} jsonLd={false} />

    <header class="mt-6 grid gap-6 md:grid-cols-[auto_1fr] md:items-start md:gap-8">
      <div class="relative grid h-[132px] w-[132px] place-items-center overflow-hidden rounded-2xl border border-orange/25 bg-gradient-to-br from-orange/15 via-transparent to-transparent">
        <PixelSprite seed={c.slug} kind="character" size={104} alt={`${c.nameZh}像素形象`} class="float-y" />
        <span class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(0deg,rgba(0,0,0,0.18)_0px,rgba(0,0,0,0.18)_1px,transparent_1px,transparent_4px)] opacity-40"></span>
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          {c.tags.map((t) => <span class="tag tag-orange">{t}</span>)}
          {c.isDlc && <span class="tag tag-dlc">DLC 角色</span>}
          <span class="tag">难度 {c.difficulty}/5 · {DIFFICULTY_LABEL[c.difficulty]}</span>
        </div>
        <h1 class="mt-3 text-[34px] font-extrabold leading-tight tracking-tight text-cream md:text-[42px]">
          {c.nameZh} <span class="ml-1 font-mono text-[16px] font-normal uppercase tracking-widest text-dim md:text-[18px]">{c.name}</span>
        </h1>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{c.tagline}</p>

        <div class="mt-5 flex flex-wrap gap-2">
          <a href="#ability" class="btn h-9 text-[13px]">专属能力</a>
          <a href="#build" class="btn h-9 text-[13px]">推荐构筑</a>
          <a href="/guides/beginner-guide" class="btn h-9 text-[13px]">新手入门</a>
        </div>
      </div>
    </header>

    <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_320px]">
      <div class="min-w-0">
        <section id="ability" class="card-flat p-5 md:p-6">
          <h2 class="flex items-center gap-2 text-[15px] font-bold text-cream">
            <span class="h-4 w-1 rounded bg-orange"></span>专属能力
          </h2>
          <ul class="mt-4 grid gap-2.5">
            {
              c.ability.map((a) => (
                <li class="flex gap-2.5 text-[13.5px] leading-relaxed text-[#ded3c7]">
                  <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[1px] bg-orange"></span>
                  <span>{a}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4 text-[12.5px] text-dim">
            <p>解锁条件：<span class="text-muted">{c.unlock}</span></p>
            {c.unlocks && <p>解锁奖励：<span class="text-muted">{c.unlocks}（{c.unlockType === 'Weapon' ? '武器' : '道具'}）</span></p>}
          </div>
        </section>

        <section class="mt-4 grid gap-4 md:grid-cols-2">
          <div class="card-flat p-5">
            <h2 class="text-[13px] font-semibold uppercase tracking-widest text-uncommon">优势</h2>
            <ul class="mt-3 grid gap-2">
              {c.pros.map((p) => <li class="text-[13px] leading-relaxed text-[#cfc4b8]">+ {p}</li>)}
            </ul>
          </div>
          <div class="card-flat p-5">
            <h2 class="text-[13px] font-semibold uppercase tracking-widest text-legendary">劣势</h2>
            <ul class="mt-3 grid gap-2">
              {c.cons.map((p) => <li class="text-[13px] leading-relaxed text-[#cfc4b8]">− {p}</li>)}
            </ul>
          </div>
        </section>

        <section id="build" class="card-flat mt-4 p-5 md:p-6">
          <h2 class="flex items-center gap-2 text-[15px] font-bold text-cream">
            <span class="h-4 w-1 rounded bg-orange"></span>推荐玩法
          </h2>
          <p class="mt-3 text-[13.5px] leading-[1.9] text-[#d5cabd]">{c.playstyle}</p>

          {
            recWeapons.length > 0 && (
              <div class="mt-5">
                <h3 class="text-[12px] font-semibold uppercase tracking-widest text-dim">推荐武器</h3>
                <div class="mt-2.5 flex flex-wrap gap-2">
                  {recWeapons.map((w) => (
                    <a href={`/weapons/${w!.slug}`} class="group flex items-center gap-2 rounded-lg border border-line bg-white/[0.03] py-1.5 pl-1.5 pr-3 transition hover:border-orange/45">
                      <PixelSprite seed={w!.slug} kind="weapon" size={22} />
                      <span class="text-[12.5px] text-cream group-hover:text-orange-2">{w!.nameZh}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          {
            recItems.length > 0 && (
              <div class="mt-4">
                <h3 class="text-[12px] font-semibold uppercase tracking-widest text-dim">推荐道具</h3>
                <div class="mt-2.5 flex flex-wrap gap-2">
                  {recItems.map((it) => (
                    <a href={`/items/${it!.slug}`} class="group flex items-center gap-2 rounded-lg border border-line bg-white/[0.03] py-1.5 pl-1.5 pr-3 transition hover:border-orange/45">
                      <PixelSprite seed={it!.slug} kind="item" rarity={it!.rarity} size={22} />
                      <span class="text-[12.5px] text-cream group-hover:text-orange-2">{it!.nameZh}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </section>

        {
          guides.length > 0 && (
            <section class="mt-4">
              <h2 class="text-[15px] font-bold text-cream">相关攻略</h2>
              <div class="mt-3 grid gap-2">
                {guides.map((g) => (
                  <a href={`/guides/${g.id}`} class="card flex items-center gap-3 p-4">
                    <span class="tag tag-orange">{g.data.category}</span>
                    <span class="min-w-0 flex-1 truncate text-[13.5px] text-cream">{g.data.title}</span>
                    <span class="shrink-0 text-dim">→</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside class="space-y-4">
        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">速览</h2>
          <dl class="mt-3 space-y-2.5 text-[12.5px]">
            <div class="flex justify-between gap-3"><dt class="text-dim">难度</dt><dd class="text-cream">{DIFFICULTY_LABEL[c.difficulty]}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">阵营</dt><dd class="text-cream">{c.isDlc ? 'DLC' : '基础'}</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">可初始武器</dt><dd class="text-cream">{c.startingWeapons.length} 种</dd></div>
            <div class="flex justify-between gap-3"><dt class="text-dim">数据版本</dt><dd class="font-mono text-cream">{SITE.version}</dd></div>
          </dl>
        </div>

        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">初始武器池</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {c.startingWeapons.slice(0, 12).map((w) => <span class="tag">{w}</span>)}
            {c.startingWeapons.length > 12 && <span class="tag">+{c.startingWeapons.length - 12}</span>}
          </div>
          <p class="mt-3 text-[11px] leading-relaxed text-dim">
            开局可在这些武器中选择 1 把（部分角色自带指定武器）。
          </p>
        </div>

        {
          related.length > 0 && (
            <div class="card-flat p-5">
              <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">相似角色</h2>
              <ul class="mt-3 space-y-2">
                {related.map((r) => (
                  <li>
                    <a href={`/characters/${r.slug}`} class="flex items-center gap-2 text-[13px] text-muted transition hover:text-orange-2">
                      <PixelSprite seed={r.slug} kind="character" size={20} />
                      {r.nameZh}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="card-flat p-5">
          <h2 class="text-[12px] font-semibold uppercase tracking-widest text-dim">数据来源</h2>
          <p class="mt-2 text-[11.5px] leading-relaxed text-dim">
            数值整理自 Brotato Wiki 角色数据模板（Patch 1.1.6.3），中文能力描述由本站翻译整理。
          </p>
          <a href="/about" class="mt-3 inline-block text-[11.5px] text-orange-2 hover:underline">查看数据说明 →</a>
        </div>
      </aside>
    </div>

    <nav class="mt-10 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="角色翻页">
      {
        prev ? (
          <a href={`/characters/${prev.slug}`} class="card p-4">
            <p class="text-[11px] text-dim">← 上一个</p>
            <p class="mt-1 text-[14px] font-medium text-cream">{prev.nameZh}</p>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next && (
          <a href={`/characters/${next.slug}`} class="card p-4 text-right">
            <p class="text-[11px] text-dim">下一个 →</p>
            <p class="mt-1 text-[14px] font-medium text-cream">{next.nameZh}</p>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
